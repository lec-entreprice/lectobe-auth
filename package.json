  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lec-entreprice/lectobe-auth.git"
  }
