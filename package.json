{
  "name": "@lectobe/auth",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cognito authentication for Lectobe frontends",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
